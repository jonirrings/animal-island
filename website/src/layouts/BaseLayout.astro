---
import '../styles/fonts.css';
import '../styles/naive.css';
import '../styles/site.css';
import { messages } from '../i18n/messages.js';

const { title = messages.zh['site.title'], description = messages.zh['site.tagline'] } = Astro.props;
---

<!doctype html>
<html lang="zh" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // 尽早套用主题与语言，避免闪烁
      (function () {
        try {
          var theme = localStorage.getItem('ai-theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.dataset.theme = theme;
          }
          var lang = localStorage.getItem('ai-lang');
          if (lang === 'zh' || lang === 'en') {
            document.documentElement.lang = lang;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#icons">跳到图标</a>

    <header class="topbar">
      <div class="shell topbar__inner">
        <a class="brand" href="/">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="30" height="30">
              <circle cx="12" cy="14" r="5" fill="#8B5E3C" />
              <circle cx="36" cy="14" r="5" fill="#8B5E3C" />
              <circle cx="12" cy="14" r="2" fill="#F4A6A4" stroke="none" />
              <circle cx="36" cy="14" r="2" fill="#F4A6A4" stroke="none" />
              <circle cx="24" cy="27" r="15" fill="#8B5E3C" />
              <circle cx="18" cy="24" r="2.5" fill="#FFFFFF" stroke="none" />
              <circle cx="30" cy="24" r="2.5" fill="#FFFFFF" stroke="none" />
              <circle cx="18" cy="25" r="1.3" fill="#2A2A2A" stroke="none" />
              <circle cx="30" cy="25" r="1.3" fill="#2A2A2A" stroke="none" />
              <ellipse cx="24" cy="32" rx="6" ry="4.5" fill="#FAEDCD" />
              <ellipse cx="24" cy="30.5" rx="2.5" ry="1.8" fill="#2A2A2A" />
            </svg>
          </span>
          <span class="brand__name">Animal Island</span>
        </a>

        <nav class="topnav">
          <a href="#icons" data-i18n="nav.icons">图标</a>
          <a href="#runtime" data-i18n="nav.runtime">运行时</a>
          <a href="#install" data-i18n="nav.install">安装</a>
          <a href="#about" data-i18n="nav.about">关于</a>
        </nav>

        <div class="topbar__actions">
          <button class="btn btn--line btn--sm" id="langToggle" type="button">
            <span data-lang-label>English</span>
          </button>
          <button class="iconbtn" id="themeToggle" type="button" aria-label="切换主题">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer" id="about">
      <div class="shell">
        <div class="footer__grid">
          <div class="footer__brand">
            <strong>Animal Island</strong>
            <p data-i18n="site.tagline">手绘 folk art 风格图标库</p>
          </div>
          <div class="footer__col">
            <h4 data-i18n="footer.col.packages">npm 包</h4>
            <a href="https://www.npmjs.com/package/@animal-island/react-icons">@animal-island/react-icons</a>
            <a href="https://www.npmjs.com/package/@animal-island/vue-icons">@animal-island/vue-icons</a>
            <a href="https://www.npmjs.com/package/@animal-island/svelte-icons">@animal-island/svelte-icons</a>
            <a href="https://www.npmjs.com/package/@animal-island/solid-icons">@animal-island/solid-icons</a>
          </div>
          <div class="footer__col">
            <h4 data-i18n="footer.col.resources">资源</h4>
            <a href="https://github.com/jonirrings/animal-island" data-i18n="footer.repo">仓库</a>
            <a href="https://github.com/jonirrings/animal-island/blob/main/icon.schema.json" data-i18n="footer.schema">元数据 Schema</a>
            <a href="https://github.com/jonirrings/animal-island/blob/main/LICENSE.md" data-i18n="footer.license">许可（MIT）</a>
          </div>
        </div>

        <div class="credit">
          <h4 data-i18n="footer.credit.title">图标来源</h4>
          <p>
            <span data-i18n="footer.credit.text">全部 936 枚图标的设计与 SVG 来自 Naive Icons，遵循 MIT 许可。</span>
          </p>
          <a class="btn btn--solid btn--sm" href="https://github.com/guokaigdg/naive-icons" target="_blank" rel="noopener">
            <span data-i18n="footer.credit.link">访问 Naive Icons</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        </div>

        <div class="footer__bottom">
          <span>© {new Date().getFullYear()} Animal Island</span>
          <span>
            Icons by
            <a href="https://github.com/guokaigdg/naive-icons" target="_blank" rel="noopener">Naive Icons</a>
            · MIT
          </span>
        </div>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import { initSite } from '../scripts/site.js';
      initSite();
    </script>
  </body>
</html>
