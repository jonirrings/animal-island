{
  "name": "@animal-island/solid-icons",
  "version": "1.0.0",
  "description": "Animal Island icons for Solid 2 — 936 hand-drawn 48×48 folk-art SVGs as tree-shakable components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "solid": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "solid": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "icons",
    "icon",
    "svg",
    "solid",
    "solidjs",
    "animal-island",
    "folk-art",
    "illustration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonirrings/animal-island.git",
    "directory": "packages/icons/solid"
  },
  "homepage": "https://github.com/jonirrings/animal-island#readme",
  "bugs": {
    "url": "https://github.com/jonirrings/animal-island/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "build-icons --targets=solid && tsc -p tsconfig.build.json && fix-esm-extensions dist .js .jsx",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@animal-island/build-icons": "workspace:*",
    "@solidjs/web": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.0",
    "solid-js": ">=2.0.0-rc.0"
  }
}
