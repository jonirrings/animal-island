{
  "name": "root",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:icons": "pnpm -r --filter \"./packages/icons/*\" run build",
    "check:icons": "pnpm --filter @animal-island/build-icons run check",
    "sync:icons": "python3 tools/build-icons/scripts/sync-icons.py --source ../naive-icons",
    "sync:icons:apply": "python3 tools/build-icons/scripts/sync-icons.py --source ../naive-icons --write",
    "sync:icon-meta": "python3 tools/build-icons/scripts/import-naive-meta.py --source ../naive-icons"
  },
  "devDependencies": {
    "@typescript/lib-dom": "npm:modern-web-types",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0"
}
